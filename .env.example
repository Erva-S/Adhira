# Tribal Scholar Saathi — Environment Configuration Example
# Copy this file to .env and provide your deployment credentials.
# Do NOT commit production keys, database passwords, or SMS secrets.

# Backend Mode: development | staging | production
ENVIRONMENT=development

# REST API Base URL (if using custom Node/Express/Django backend)
API_BASE_URL=https://api.tribal-scholar.gov.in/v1

# Supabase Configuration
# Required when connecting to hosted or self-hosted Supabase PostgreSQL backend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# DigiLocker Sandbox / Production OAuth Credentials (Optional)
# Leave blank to use built-in MockDigiLockerService
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=tribalscholar://digilocker/callback

# Government Service Gateways (Optional)
# System defaults to safe simulated mock adapters when endpoints are omitted
NSP_API_URL=
SFMP_API_URL=
NOS_PORTAL_URL=
UIDAI_VERIFICATION_URL=
