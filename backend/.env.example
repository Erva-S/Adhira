# Google Gemini API Key (Server-side ONLY - Never expose to client/Flutter code)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Gemini 3.8 Flash or Gemini 2.5 Flash / Gemini 1.5 Flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Port
PORT=3000

# Environment mode: development | staging | production
NODE_ENV=development
